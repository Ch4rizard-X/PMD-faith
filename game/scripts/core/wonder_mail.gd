class_name WonderMail
extends RefCounted
## PMD Red Rescue Team Wonder Mail: 24-symbol mission passwords, byte-for-byte compatible with the GBA game.
##
## Ported from pret/pmd-red:
##   src/code_803D0D8.c    DecodeWonderMailPassword / sub_803D414 (encode), sub_803D110 / sub_803D1A8 (5-bit
##                         symbol packing), sUnknown_80F42D0 (symbol set), gUnknown_80F4426 (position scramble)
##   src/code_80958E8.c    ReadWonderMailBits / WriteWonderMailBits (bit layout), IsValidWonderMail /
##                         ValidateWonderMail (what Red accepts), IsMailinJobSlot (duplicates)
##   src/data_serializer.c ReadBits / WriteBits (LSB-first bit stream)
##   src/code_803C1B4.c    difficulty, rank points and money of a mail (sub_803C1B4 / sub_803C1D0 / sub_803C21C)
##   src/wonder_mail_main_menu.c, src/wonder_mail_802D098.c (password entry -> "Received the Wonder Mail!")
##
## Password format (decomp-exact):
##   * 15 data bytes. byte 0 = checksum = sum over i = 1..14 of (byte[i] + i), mod 256.
##   * bytes 1..12 hold a little-endian, LSB-first bit stream (93 bits used, the rest and bytes 13..14 are 0):
##       mailType 4 (must be 5) | missionType 3 | unk2 ("special") 4 | clientSpecies 9 | targetSpecies 9 |
##       targetItem 8 | rewardType 4 | itemReward 8 | friendAreaReward 6 | seed 24 | dungeon 7 | floor 7
##   * the 120 bits are cut into 24 five-bit values (LSB first), each mapped through CHARSET,
##   * then symbol i is written to position SCRAMBLE[i] of the password.
##
##   var r := WonderMail.decode("...24 symbols...")   # {ok, error, job, raw}
##   var code := WonderMail.encode({"kind": "rescue", "dungeon": "mt_steel", "floor": 5, "client": "0025",
##       "reward": {"type": "money1"}})                 # "" if Red would refuse it (see encode_ex for why)

## Red's password symbols in value order (sUnknown_80F42D0; Red bytes 0x85 = ⋯, 0xBD = ♂, 0xBE = ♀).
const CHARSET := "?67NPR89F0+…STXY45MCHJ-K12!♀3Q♂W"
const CODE_LEN := 24
## gUnknown_80F4426: password position of symbol i.
const SCRAMBLE := [12, 6, 19, 8, 4, 13, 15, 9, 16, 2, 20, 18, 0, 21, 11, 5, 23, 3, 17, 10, 1, 14, 22, 7]
const MAIL_TYPE_WONDER := 5            # WONDER_MAIL_TYPE_WONDER
## WonderMailMissionTypes -> job kinds of Missions.
const KINDS := ["rescue", "target", "escort", "find", "deliver"]
## enum RewardType (index 4 = BLANK_4 is never valid).
const REWARD_TYPES := ["money", "money_extra", "item", "item_extra", "", "money1", "money1_extra", "item1", "item1_extra", "friend_area"]
const RANK_POINTS := [1, 5, 10, 20, 40, 60, 80, 100, 150, 200, 300, 500, 700, 1000, 1500, 2000]
const DIFF_LETTERS := ["E", "D", "C", "B", "A", "S", "*"]
const THROWN_REWARD_QTY := 10
## Dungeons that only open by receiving a Wonder Mail for them (wonder_mail_802D098.c: SetRescueScenarioConquered).
const WM_ONLY_DUNGEONS := [43, 44, 45, 46]

const ERR_INCORRECT := "This password is incorrect."
const ERR_UNSUPPORTED := "This Wonder Mail can't be used in this game."
const MSG_RECEIVED := "Received the [color=#7fe0ff]Wonder Mail[/color]!"
const MSG_ADDED := "The received [color=#7fe0ff]Wonder Mail[/color] was\nadded to the [color=#7fe0ff]Job List[/color]."
