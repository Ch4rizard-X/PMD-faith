## GetDungeonLocMissionDifficulty + sub_803C1B4 (escort +2, max 15).
static func mission_difficulty(d: int, fl: int, mission: int) -> int:
	var v := 1
	if d >= 0 and d < RED_NUM_DUNGEONS and fl < floor_count(d):
		v = int(RED_DIFFICULTY[d][fl])
	if mission == 2:
		v += 2
	return mini(v, 15)

## sub_803C1D0: difficulty letter 0 (E) .. 6 (*).
static func letter_index(diff: int) -> int:
	return mini(diff / 2, 6)

static func is_thrown(red_item: int) -> bool:
	_init_tables()
	return _thrown.has(red_item)

## IsInvalidItemReward
static func is_invalid_item(red_item: int) -> bool:
	_init_tables()
	return red_item < 0 or red_item >= RED_NUM_ITEMS or _bad_items.has(red_item)

## xxx_bit_lut_lookup_8091E50: can the item be found in the dungeon.
static func item_in_dungeon(d: int, red_item: int) -> bool:
	if d < 0 or d >= RED_ITEM_LUT.size() - 1 or red_item < 0 or red_item > 255:
		return false
	var row: String = RED_ITEM_LUT[d]
	var byte := row.substr((red_item >> 3) * 2, 2).hex_to_int()
	return (byte >> (red_item & 7)) & 1 == 1

## sub_803C0DC + GetBaseSpecies checks of ValidateWonderMail.
static func species_ok(red_id: int) -> bool:
	_init_tables()
	return red_id >= 0 and red_id < RED_MONSTER_MAX and not _not_base.has(red_id) and not _banned.has(red_id)

static func target_item_ok(red_item: int) -> bool:
	return not is_invalid_item(red_item) and not is_thrown(red_item) and red_item != 0 and red_item != RED_ITEM_POKE and red_item != RED_ITEM_USED_TM

static func dungeon_ok(d: int) -> bool:
	return d >= 0 and d < RED_NUM_DUNGEONS and not d in RED_INVALID_DUNGEONS

static func floor_ok(d: int, fl: int) -> bool:
	_init_tables()
	return fl < floor_count(d) and not _no_job.has("%d:%d" % [d, fl])

## ValidateWonderMail (+ IsValidWonderMail's mail type check). Returns "" when Red accepts the mail, else why not.
## Stricter than Red in two corner cases this game can't represent: floor 0 and target species 0 are refused.
static func validate_raw(r: Dictionary) -> String:
	_init_tables()
	var mission := int(r.get("mission", 0))
	var d := int(r.get("dungeon", 0))
	var fl := int(r.get("floor", 0))
	var client := int(r.get("client", 0))
	var target := int(r.get("target", 0))
	var ti := int(r.get("target_item", 0))
	var rt := int(r.get("reward_type", 0))
	if int(r.get("mail_type", 0)) != MAIL_TYPE_WONDER:
		return "not a Wonder Mail (mail type %d)" % int(r.get("mail_type", 0))
	if mission > 4:
		return "bad mission type %d" % mission
	if mission == 4 and d < RED_NUM_DUNGEONS and int(RED_MAX_ITEMS[d]) == 0:
		return "items can't be delivered in this dungeon"
	if int(r.get("special", 0)) > 9:
		return "bad mail variant"
	if not dungeon_ok(d):
		return "dungeon %d not allowed" % d
	if fl >= floor_count(d):
		return "floor %d out of range" % fl
	if fl == 0:
		return "floor 0"
	if _no_job.has("%d:%d" % [d, fl]):
		return "no jobs on this floor"
	if client == 0 or not species_ok(client):
		return "client species %d not allowed" % client
	if target == 0 or not species_ok(target):
		return "target species %d not allowed" % target
	if mission != 1 and mission != 2 and target != client:
		return "this job type can't have a different target"
	if is_invalid_item(ti) or is_thrown(ti) or ti == 0 or ti == RED_ITEM_POKE or ti == RED_ITEM_USED_TM:
		return "target item %d not allowed" % ti
	if mission == 3 and not item_in_dungeon(d, ti):
		return "that item can't be found in this dungeon"
	if rt == 4 or rt >= 10:
		return "bad reward type"
	if is_invalid_item(int(r.get("item_reward", 0))):
		return "reward item not allowed"
	var fa := int(r.get("friend_area", 0))
	if fa > RED_FRIEND_AREA_MAX:
		return "bad friend area"
	if rt == 9:
		if not fa in RED_WM_FRIEND_AREAS:
			return "that Friend Area isn't a Wonder Mail reward"
		if letter_index(mission_difficulty(d, fl, mission)) == 0:
			return "Friend Area rewards need difficulty D or higher"
	return ""

## Extra check that every id of the mail exists in this game's data.
static func supported_raw(r: Dictionary) -> String:
	if dungeon_key(int(r.dungeon)) == "":
		return "dungeon %d missing" % int(r.dungeon)
	for f in ["client", "target"]:
		var k := species_key(int(r[f]))
		if k == "" or not DB.species.has(k):
			return "species %d missing" % int(r[f])
	var mission := int(r.mission)
	if (mission == 3 or mission == 4) and not DB.items.has(item_key(int(r.target_item))):
		return "item %d missing" % int(r.target_item)
	var rt := int(r.reward_type)
	if rt in [1, 2, 3, 6, 7, 8] and int(r.item_reward) != 0 and not DB.items.has(item_key(int(r.item_reward))):
		return "item %d missing" % int(r.item_reward)
	return ""

# ============================================================================ decode
## Password -> {ok, error, job, raw}. job uses the Missions job format plus wonder_mail = true, code, red (raw).
static func decode(code: String) -> Dictionary:
	var n := normalize(code)
	var res := {"ok": false, "error": ERR_INCORRECT, "job": {}, "raw": {}, "reason": ""}
	if n.length() != CODE_LEN:
		res.reason = "a password has 24 symbols"
		return res
	for cand in _alias_candidates(n):
		var raw := decode_raw(cand)
		if raw.is_empty():
			res.reason = "checksum / symbol"
			continue
		var why := validate_raw(raw)
		if why != "":
			res.reason = why
			continue
		why = supported_raw(raw)
		if why != "":
			res.error = ERR_UNSUPPORTED
			res.reason = why
			continue
		res.ok = true
		res.error = ""
		res.reason = ""
		res.raw = raw
		res.job = job_from_raw(raw, cand)
		return res
	return res

static func _alias_candidates(n: String) -> Array:
	var out: Array = [n]
	for a in AMBIGUOUS:
		if n.find(a) < 0:
			continue
		var nxt: Array = []
		for c in out:
			for rep in AMBIGUOUS[a]:
				nxt.append(c.replace(a, rep))
		out = nxt
	return out

## Red fields -> job Dictionary (Missions format).
static func job_from_raw(r: Dictionary, code := "") -> Dictionary:
	if code == "":
		code = encode_raw(r)
	var mission := int(r.mission)
	var d := int(r.dungeon)
	var fl := int(r.floor)
	var kind: String = KINDS[mission]
	var diff := mission_difficulty(d, fl, mission)
	var li := letter_index(diff)
	var item := item_key(int(r.target_item)) if kind == "find" or kind == "deliver" else ""
	var j := {"id": "wm-" + _code_id(code), "kind": kind, "special": int(r.special), "dungeon": dungeon_key(d), "floor": fl,
		"client": species_key(int(r.client)), "target": species_key(int(r.target)), "item": item, "seed": int(r.seed),
		"diff": diff, "difficulty": DIFF_LETTERS[li], "accepted": false, "state": "board", "source": "wonder_mail",
		"wonder_mail": true, "code": code, "red": r.duplicate()}
	var t: String = REWARD_TYPES[int(r.reward_type)]
	var ri := item_key(int(r.item_reward))
	var rw := {"type": t, "money": 0, "item": "", "item_n": 0, "extra": 0, "rank_points": RANK_POINTS[diff], "friend_area": ""}
	match t:
		"money": rw.money = (li + 1) * 100
		"money_extra": rw.money = (li + 1) * 100; rw.item = ri
		"item": rw.item = ri
		"item_extra": rw.item = ri; rw.extra = 1
		"money1": rw.money = (li + 1) * 200
		"money1_extra": rw.money = (li + 1) * 200; rw.item = ri
		"item1": rw.item = ri
		"item1_extra": rw.item = ri; rw.extra = 2
		"friend_area": rw.friend_area = friend_area_key(int(r.friend_area))
	if rw.item != "":
		rw.item_n = THROWN_REWARD_QTY if is_thrown(int(r.item_reward)) else 1
	j.reward = rw
	Missions.describe(j)
	return j

static func _code_id(code: String) -> String:
	var s := ""
	for ch in code:
		var v := symbol_value(ch)
		s += "%02d" % v if v >= 0 else "xx"
	return s

# ============================================================================ encode
## Job-ish fields (project keys) -> Red fields. Accepts:
##   kind ("rescue" | "target" | "escort" | "find" | "deliver") or mission (0..4), dungeon (key or Red index), floor,
##   client, target (species keys; target defaults to client), item (key; find/deliver; rescue kinds get a valid
##   dummy like Red's), reward: {type: "money".."friend_area" or 0..9, item, friend_area} (or reward_type /
##   reward_item / friend_area at top level), special (0..9), seed (24 bits; random if missing).
## A dictionary that already holds Red fields under "red" is re-encoded as is.
static func raw_from_fields(f: Dictionary) -> Dictionary:
	_init_tables()
	if f.get("red", null) is Dictionary and not f.red.is_empty():
		return f.red.duplicate()
	var r := {"mail_type": MAIL_TYPE_WONDER}
	var mission := int(f.get("mission", kind_index(str(f.get("kind", "rescue")))))
	r.mission = maxi(mission, 0)
	var dv = f.get("dungeon", 0)
	r.dungeon = dungeon_index(dv) if dv is String else int(dv)
	r.floor = int(f.get("floor", 1))
	r.special = int(f.get("special", 0))
	var cv = f.get("client", "")
	r.client = species_id(cv) if cv is String else int(cv)
	var tv = f.get("target", "")
	if (tv is String and tv == "") or (r.mission != 1 and r.mission != 2):
		r.target = r.client
	else:
		r.target = species_id(tv) if tv is String else int(tv)
	var iv = f.get("item", "")
	var ti: int = (item_id(iv) if iv != "" else -1) if iv is String else int(iv)
	if r.mission != 3 and r.mission != 4 and not target_item_ok(ti):
		ti = _dummy_target_item(int(r.dungeon), int(f.get("seed", 0)))
	r.target_item = maxi(ti, 0)
	var rw: Dictionary = f.get("reward", {}) if f.get("reward", null) is Dictionary else {}
	var rtv = rw.get("type", f.get("reward_type", "money"))
	r.reward_type = reward_type_index(rtv) if rtv is String else int(rtv)
	var riv = rw.get("item", f.get("reward_item", ""))
	var ri: int = (item_id(riv) if riv != "" else 0) if riv is String else int(riv)
	r.item_reward = maxi(ri, 0)
	var fav = rw.get("friend_area", f.get("friend_area", 0))
	r.friend_area = friend_area_index(fav) if fav is String else int(fav)
	if f.has("seed"):
		r.seed = int(f.seed) & 0xffffff
	else:
		r.seed = randi() & 0xffffff
	return r

## Red's generator gives every job a target item from the dungeon (sub_8095F28) even when unused.
static func _dummy_target_item(d: int, seed: int) -> int:
	var pool: Array = []
	for i in range(1, RED_NUM_ITEMS):
		if target_item_ok(i) and item_in_dungeon(d, i):
			pool.append(i)
	if pool.is_empty():
		return item_id("oran") if item_id("oran") > 0 else 70
	return pool[seed % pool.size()]

## {ok, error, code, raw}: error explains why Red would refuse the mail.
static func encode_ex(fields: Dictionary) -> Dictionary:
	var raw := raw_from_fields(fields)
	var why := validate_raw(raw)
	if why != "":
		return {"ok": false, "error": why, "code": "", "raw": raw}
	return {"ok": true, "error": "", "code": encode_raw(raw), "raw": raw}

## Password for the fields, or "" if Red would refuse it.
static func encode(job_fields: Dictionary) -> String:
	return str(encode_ex(job_fields).code)

# ============================================================================ lists for the maker
## Dungeons Red allows in a Wonder Mail (and this game has).
static func wm_dungeons() -> Array:
	var out: Array = []
	for d in RED_NUM_DUNGEONS:
		if dungeon_ok(d) and dungeon_key(d) != "" and not wm_floors(d).is_empty():
			out.append(d)
	return out

static func wm_floors(d: int) -> Array:
	var out: Array = []
	if not dungeon_ok(d):
		return out
	for fl in range(1, floor_count(d)):
		if floor_ok(d, fl):
			out.append(fl)
	return out

## Species keys Red accepts as client / target (base forms, not banned) that exist in this game.
static func wm_species() -> Array:
	_init_tables()
	var out: Array = []
	for k in _sp_id:
		if species_ok(int(_sp_id[k])) and DB.species.has(k):
			out.append(k)
	out.sort()
	return out

## Items for a find job in dungeon d (must be findable there) or a deliver job (any non-thrown item).
static func wm_target_items(d: int, kind: String) -> Array:
	var out: Array = []
	for i in range(1, RED_NUM_ITEMS):
		if not target_item_ok(i) or not DB.items.has(item_key(i)):
			continue
		if kind == "find" and not item_in_dungeon(d, i):
			continue
		out.append(item_key(i))
	return out

static func wm_reward_items() -> Array:
	var out: Array = []
	for i in range(1, RED_NUM_ITEMS):
		if not is_invalid_item(i) and i != RED_ITEM_POKE and DB.items.has(item_key(i)):
			out.append(item_key(i))
	return out

## Wonder-Mail Friend Areas (keys) allowed for this location / job type ([] below difficulty D).
static func wm_friend_areas(d: int, fl: int, kind: String) -> Array:
	var out: Array = []
	if letter_index(mission_difficulty(d, fl, kind_index(kind))) == 0:
		return out
	for i in RED_WM_FRIEND_AREAS:
		out.append(friend_area_key(int(i)))
	return out

## Job kinds Red allows in dungeon d (deliver needs a dungeon that allows items; find needs a findable item).
static func wm_kinds(d: int) -> Array:
	var out: Array = []
	for k in KINDS:
		if k == "deliver" and int(RED_MAX_ITEMS[d]) == 0:
			continue
		if k == "find" and wm_target_items(d, "find").is_empty():
			continue
		out.append(k)
	return out

# ============================================================================ receiving
## Is the mail already in the Job List (IsMailinJobSlot compares every field but the mail type; also by code).
static func in_job_list(job: Dictionary) -> bool:
	for j in Game.jobs:
		if str(j.get("code", "")) != "" and str(j.get("code", "")) == str(job.get("code", "")):
			return true
		if j.get("red", null) is Dictionary and job.get("red", null) is Dictionary:
			var a: Dictionary = j.red
			var b: Dictionary = job.red
			var same := true
			for f in FIELDS:
				if f[0] != "mail_type" and int(a.get(f[0], -1)) != int(b.get(f[0], -2)):
					same = false
			if same:
				return true
	return false

## Red remembers the last 16 completed Wonder Mails (sub_8096EEC / sub_8096F50) and refuses them again.
## Call note_completed(job) when a Wonder Mail job is finished to get the same behaviour.
static func was_completed(job: Dictionary) -> bool:
	var h = Game.flags.get("wm_done", [])
	return h is Array and str(job.get("code", "")) in h

static func note_completed(job: Dictionary) -> void:
	if not job.get("wonder_mail", false):
		return
	var h = Game.flags.get("wm_done", [])
	if not h is Array:
		h = []
	h.push_front(str(job.get("code", "")))
	while h.size() > 16:
		h.pop_back()
	Game.flags["wm_done"] = h

## Adds a decoded job to the Job List. Returns "" on success or Red's message why not.
static func receive(job: Dictionary) -> String:
	if in_job_list(job):
		return MSG_DUPLICATE
	if was_completed(job):
		return MSG_USED
	if Game.jobs.size() >= Missions.MAX_JOBS:
		return MSG_FULL
	if not Missions.accept(job):
		return MSG_FULL
	# Receiving a Wonder Mail for one of the four Wonder-Mail-only dungeons opens it.
	var d := dungeon_index(str(job.get("dungeon", "")))
	if d in WM_ONLY_DUNGEONS and not job.dungeon in Game.unlocked:
		Game.unlocked.append(job.dungeon)
	Game.save_game()
	return ""
