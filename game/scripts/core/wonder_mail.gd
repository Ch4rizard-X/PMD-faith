# ============================================================================ symbols
static func symbol_value(ch: String) -> int:
	return CHARSET.find(ch)

## Uppercases, drops spaces / new lines and maps alternative spellings. "*" and "/" are left as they are.
static func normalize(code: String) -> String:
	var out := ""
	for ch in code:
		if ch == " " or ch == "\n" or ch == "\t" or ch == "\r":
			continue
		var c: String = ch.to_upper() if ch.unicode_at(0) < 128 else ch
		out += str(ALIASES.get(c, c))
	return out

## How to show a symbol with res://assets/ui/pmd_red_text.ttf (Red's font keeps ♂ / ♀ at Latin-1 ½ / ¾).
static func font_glyph(ch: String) -> String:
	if ch == "♂":
		return "½"
	if ch == "♀":
		return "¾"
	return ch

static func font_text(code: String) -> String:
	var s := ""
	for ch in code:
		s += font_glyph(ch)
	return s

# ============================================================================ bits
static func _put_bits(buf: PackedByteArray, pos: int, value: int, n: int) -> int:
	for b in n:
		if (value >> b) & 1:
			buf[pos >> 3] = buf[pos >> 3] | (1 << (pos & 7))
		pos += 1
	return pos

static func _get_bits(buf: PackedByteArray, pos: int, n: int) -> int:
	var v := 0
	for b in n:
		if (buf[pos >> 3] >> (pos & 7)) & 1:
			v |= 1 << b
		pos += 1
	return v

const FIELDS := [["mail_type", 4], ["mission", 3], ["special", 4], ["client", 9], ["target", 9], ["target_item", 8],
	["reward_type", 4], ["item_reward", 8], ["friend_area", 6], ["seed", 24], ["dungeon", 7], ["floor", 7]]

## Red's bytes -> password (sub_803D414). raw = {mail_type, mission, special, client, target, target_item,
## reward_type, item_reward, friend_area, seed, dungeon, floor} (Red ids). No validity check.
static func encode_raw(raw: Dictionary) -> String:
	var data := PackedByteArray()
	data.resize(15)
	var pos := 8
	for f in FIELDS:
		pos = _put_bits(data, pos, int(raw.get(f[0], 0)) & ((1 << f[1]) - 1), f[1])
	var sum := 0
	for i in range(1, 15):
		sum += data[i] + i
	data[0] = sum & 0xff
	var plain: Array = []
	for i in CODE_LEN:
		plain.append(CHARSET[_get_bits(data, i * 5, 5)])
	var out: Array = []
	out.resize(CODE_LEN)
	for i in CODE_LEN:
		out[SCRAMBLE[i]] = plain[i]
	return "".join(PackedStringArray(out))

## Password -> Red's fields (DecodeWonderMailPassword). {} if a symbol is unknown or the checksum is wrong.
static func decode_raw(code: String) -> Dictionary:
	if code.length() != CODE_LEN:
		return {}
	var data := PackedByteArray()
	data.resize(15)
	for i in CODE_LEN:
		var v := symbol_value(code[SCRAMBLE[i]])
		if v < 0:
			return {}
		_put_bits(data, i * 5, v, 5)
	var sum := 0
	for i in range(1, 15):
		sum += data[i] + i
	if data[0] != (sum & 0xff):
		return {}
	var raw := {}
	var pos := 8
	for f in FIELDS:
		raw[f[0]] = _get_bits(data, pos, f[1])
		pos += f[1]
	return raw

# ============================================================================ Red tables
static func _init_tables() -> void:
	if not _thrown.is_empty():
		return
	for i in RED_THROWN_ITEMS:
		_thrown[int(i)] = true
	for i in RED_INVALID_ITEMS:
		_bad_items[int(i)] = true
	for i in RED_BANNED_SPECIES:
		_banned[int(i)] = true
	for i in RED_NOT_BASE_SPECIES:
		_not_base[int(i)] = true
	for p in RED_NO_JOB_FLOORS:
		_no_job["%d:%d" % [p[0], p[1]]] = true
	for i in RED_SPECIES.size():
		var k: String = RED_SPECIES[i]
		if k != "" and not _sp_id.has(k) and not _not_base.has(i):
			_sp_id[k] = i
	for i in RED_ITEMS.size():
		if RED_ITEMS[i] != "" and not _it_id.has(RED_ITEMS[i]):
			_it_id[RED_ITEMS[i]] = i

static func _init_dungeons() -> void:
	if not _dkey.is_empty():
		return
	var dd: Dictionary = DB.dungeons.get("dungeons", {})
	for k in dd:
		var idx := int(dd[k].get("index", -1))
		if idx >= 0 and idx < RED_NUM_DUNGEONS and not _dkey.has(idx):
			_dkey[idx] = k
			_dind[k] = idx

