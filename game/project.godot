; Engine configuration file.
config_version=5

[application]
config/name="PMD Red Rescue Team"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[display]
window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/handheld/orientation=6
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true

[autoload]

DB="*res://scripts/core/db.gd"
Game="*res://scripts/core/game.gd"
Audio="*res://scripts/core/audio.gd"

[gui]

theme/default_font_antialiasing=0

[debug]

gdscript/warnings/inference_on_variant=1

[editor_plugins]

enabled=PackedStringArray("res://addons/thor_screen/plugin.cfg")
