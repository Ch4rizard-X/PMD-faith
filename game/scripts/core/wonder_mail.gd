## Typing helpers: other spellings people use for the three non-ASCII symbols.
const ALIASES := {".": "…", "#": "…", "⋯": "…", "·": "…", "½": "♂", "¾": "♀", "♂": "♂", "♀": "♀"}
## Ambiguous ASCII stand-ins (community tools disagree); decode tries both meanings.
const AMBIGUOUS := {"*": ["♂", "♀"], "/": ["♀", "♂"]}

